---
import Layout from '../../components/Layout.astro';
import Workspace from '../../components/Workspace.astro';
import routesJson from '../../data/routes.json';
import {titleFor,topicIntro,howTo,category} from '../../lib/site';
export function getStaticPaths(){return routesJson.filter(x=>x.type!=='HOLD').map(r=>({params:{slug:r.slug},props:{route:r}}));}
const {route}=Astro.props;
const title=titleFor(route.slug);
const categories=routesJson.filter(x=>x.type!=='HOLD'&&x.slug!==route.slug&&category(x.slug)===category(route.slug)).slice(0,6);
const preview=`/images/worksheets/${route.slug}-sample.webp`;
---
<Layout title={`${title} – Free Printable PDF & Answer Key | Math Worksheet Studio`} description={topicIntro(route.slug)} canonicalPath={`/${route.slug}/`}>
<div class="container"><section class="hero hero-compact"><div class="crumb"><a href="/">All math worksheets</a> / {category(route.slug)}</div><span class="eyebrow">Make it · Print it · Practice it</span><h1>{title}</h1><p>{topicIntro(route.slug)}</p></section><Workspace slug={route.slug}/>
<section class="info-grid"><div class="panel info-panel"><h2>How to use this worksheet</h2><ol>{howTo(route.slug).map(item=><li>{item}</li>)}</ol><p>Refresh the seed to generate another distinct set. For review, download the separate answer PDF instead of printing answers over the questions.</p></div><div class="panel info-panel"><h2>Example printable practice</h2><p>A fixed-seed preview created from the same deterministic generator used above.</p><img class="sample-img" src={preview} width="1000" height="560" alt={`${title} printable practice sample with real generated question`}/></div></section>
<section class="topic-section"><div class="section-header"><div><span class="eyebrow">Keep practicing</span><h2>Related worksheets</h2></div><a href="/#topics">Browse all topics</a></div><div class="topic-grid">{categories.map(r=><a href={`/${r.slug}/`} class="topic-card"><strong>{titleFor(r.slug)}</strong><small>Fresh printable questions with answers</small><span class="topic-link">Open worksheet →</span></a>)}</div></section>
</div></Layout>
