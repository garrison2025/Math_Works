---
import Layout from '../components/Layout.astro';
import Workspace from '../components/Workspace.astro';
import routesJson from '../data/routes.json';
import {category,titleFor} from '../lib/site';
const routes=routesJson.filter(x=>x.type!=='HOLD');
const groups=['Arithmetic & Numbers','Algebra & Functions','Geometry & Graphs','Data & Statistics'];
---
<Layout title="Free Printable Math Worksheet Generator | Math Worksheet Studio" description="Create fresh printable math worksheets, answer keys and worked solutions on selected topics. Choose from algebra, fractions, geometry, arithmetic, and more. No account required.">
<div class="container"><section class="hero"><span class="eyebrow">Free printable teaching tools</span><h1>A better way to make math practice.</h1><p>Choose a math topic, generate fresh problems, and get a clean worksheet with matching answers. Built for teachers, parents, and independent practice.</p></section><Workspace slug="two-step-equations-worksheets"/>
<section id="topics" class="topic-section"><div class="section-header"><div><span class="eyebrow">Explore the library</span><h2>Choose a practice topic</h2><p>Each topic opens its own worksheet generator, preview and answer key.</p></div></div>{groups.map(group=><div class="topic-group"><h3>{group}</h3><div class="topic-grid">{routes.filter(r=>category(r.slug)===group).map(r=><a class="topic-card" href={`/${r.slug}/`}><strong>{titleFor(r.slug)}</strong><small>Printable practice · Answer key included</small><span class="topic-link">Open worksheet →</span></a>)}</div></div>)}</section>
<section class="topic-section" aria-labelledby="practice-paths-heading"><div class="section-header"><div><span class="eyebrow">More ways to find the right practice</span><h2 id="practice-paths-heading">Explore by grade, subject or real-world story</h2><p>Use a focused worksheet generator or navigate to the exact skill you need.</p></div></div>
<div class="topic-grid">
<a class="topic-card" href="/word-problems-worksheets/"><strong>Original Word Problems</strong><small>Generate proportion, area, multiplication and division stories, with separate PDF keys</small><span class="topic-link">Open story generator →</span></a>
<a class="topic-card" href="/worksheets-by-grade/"><strong>Math by Suggested Grade</strong><small>Browse working skill tools recommended for grades 5, 6, 7 and 8</small><span class="topic-link">Explore grades →</span></a>
<a class="topic-card" href="/algebra-general-worksheets/"><strong>Algebra Practice Directory</strong><small>Equations, inequalities, systems, functions and graphing</small><span class="topic-link">Explore algebra →</span></a>
<a class="topic-card" href="/geometry-general-worksheets/"><strong>Geometry Practice Directory</strong><small>Area, angles, measurement, Pythagorean theorem and coordinate geometry</small><span class="topic-link">Explore geometry →</span></a>
</div></section>
<section id="how-it-works" class="info-grid"><div class="panel info-panel"><h2>Three steps to a printable worksheet</h2><ol><li>Pick your topic and adjust the difficulty or question count.</li><li>Preview the questions and create a new reproducible set.</li><li>Download the questions and answers (and worked steps where verified), or print directly.</li></ol></div><div class="panel info-panel"><h2>Designed for real classrooms</h2><p>Worksheets are generated from deterministic math routines, not copied PDFs. The same seed produces matching question and answer sets, so you can recreate any worksheet later.</p><p>No student login, hosted database, or paid generation service is required.</p></div></section></div>
</Layout>
