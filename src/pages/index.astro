---
import Layout from '../components/Layout.astro';
import Workspace from '../components/Workspace.astro';
import routesJson from '../data/routes.json';
import {category,titleFor} from '../lib/site';
const routes=routesJson.filter(x=>x.type!=='HOLD');
const groups=[
 {id:'numbers',name:'Arithmetic & Numbers',symbol:'+',description:'Build fluency with arithmetic, fractions and decimals.'},
 {id:'algebra',name:'Algebra & Functions',symbol:'x',description:'Practice equations, expressions and relationships.'},
 {id:'geometry',name:'Geometry & Graphs',symbol:'△',description:'Work through shapes, measurement and coordinate ideas.'},
 {id:'statistics',name:'Data & Statistics',symbol:'▥',description:'Read, construct and interpret data.'}
];
---
<Layout title="Math Worksheet Studio | Free Printable Math Worksheets" description="Create free, reproducible math worksheets with 51 focused generators. No account or student-data upload; print matching answer-key PDFs in US Letter or A4.">
 <div class="container">
  <section class="hero hero-home" aria-labelledby="home-heading">
   <div class="hero-copy">
    <span class="eyebrow hero-eyebrow"><span class="eyebrow-spark" aria-hidden="true"></span> Built for better math practice</span>
    <h1 id="home-heading">Free printable math worksheets, <span class="hero-accent">made simple.</span></h1>
    <p>Create reproducible practice with 51 focused math-topic generators, right in your browser. Choose a skill and difficulty, then print matching student and answer-key PDFs. No account or student-data upload is needed. Worked steps are available on supported topics.</p>
    <div class="hero-actions">
     <a class="btn btn-primary hero-primary" href="/worksheets/">Find your worksheet <span aria-hidden="true">↗</span></a>
     <a class="btn hero-secondary" href="#try-a-worksheet">Try a live example <span aria-hidden="true">↓</span></a>
    </div>
    <ul class="hero-highlights" aria-label="Worksheet studio benefits">
     <li><span aria-hidden="true">✓</span> No account needed</li>
     <li><span aria-hidden="true">✓</span> Letter &amp; A4 PDFs</li>
     <li><span aria-hidden="true">✓</span> Matching answer keys</li>
    </ul>
   </div>
   <div class="hero-illustration" aria-hidden="true">
    <div class="hero-halo hero-halo-one"></div><div class="hero-halo hero-halo-two"></div>
    <div class="hero-preview-window">
     <div class="hero-preview-toolbar"><span class="hero-preview-dots"><i></i><i></i><i></i></span><span>Worksheet preview</span><span class="hero-toolbar-pill">PDF READY</span></div>
     <div class="hero-paper-preview">
      <div class="hero-paper-top"><span>MATH WORKSHEET STUDIO</span><span>01 / 01</span></div>
      <strong class="hero-paper-title">Two-step equations</strong>
      <div class="hero-paper-byline"><span>Name: ____________________</span><span>Date: __________</span></div>
      <div class="hero-paper-problems">
       <div><small>01</small><strong>2x + 7 = 19</strong><span>x = ______</span></div>
       <div><small>02</small><strong>3x − 4 = 11</strong><span>x = ______</span></div>
       <div><small>03</small><strong>4x + 9 = 25</strong><span>x = ______</span></div>
      </div>
      <div class="hero-paper-footer">Practice sheet · Sample layout</div>
     </div>
    </div>
    <div class="hero-float hero-float-key"><span class="hero-float-icon">✓</span><span><strong>Answers included</strong><small>Same questions, every time</small></span></div>
    <div class="hero-float hero-float-print"><span aria-hidden="true">↗</span> Ready for the classroom</div>
   </div>
  </section>

  <section class="demo-section" id="try-a-worksheet" aria-labelledby="example-worksheet">
   <div class="demo-intro">
    <div><span class="eyebrow">Make one right here</span><h2 id="example-worksheet">Your next worksheet starts here.</h2><p>Adjust the settings, see the page as you build it, then download a clean, ready-to-print PDF.</p></div>
    <span class="demo-detail"><span class="demo-live-dot" aria-hidden="true"></span> Live, in-browser generator</span>
   </div>
   <Workspace slug="two-step-equations-worksheets"/>
  </section>

  <section id="topics" class="topic-section" aria-labelledby="topics-heading">
   <div class="section-header"><div><span class="eyebrow">Explore the library</span><h2 id="topics-heading">A worksheet for every next step.</h2><p>Explore {routes.length} working topic generators, organised by the skills you're teaching.</p></div><a class="section-quick-link" href="/worksheets/">Search all worksheets <span aria-hidden="true">↗</span></a></div>
   {groups.map(group=><section class="topic-group" aria-labelledby={`topic-group-${group.id}`}><div class="topic-group-heading"><span class="topic-group-symbol" aria-hidden="true">{group.symbol}</span><div><h3 id={`topic-group-${group.id}`}>{group.name}</h3><p>{group.description}</p></div><span class="topic-group-count">{routes.filter(r=>category(r.slug)===group.name).length} topics</span></div><div class="topic-grid">{routes.filter(r=>category(r.slug)===group.name).map(r=><a class="topic-card" href={`/${r.slug}/`}><strong>{titleFor(r.slug)}</strong><small>Printable practice · Matching answer key</small><span class="topic-link">Open worksheet <span aria-hidden="true">↗</span></span></a>)}</div></section>)}
  </section>

  <section class="topic-section pathways-section" aria-labelledby="practice-paths-heading">
   <div class="section-header"><div><span class="eyebrow">Find your way</span><h2 id="practice-paths-heading">Prefer to browse another way?</h2><p>Choose a grade, a subject, or practical word problems.</p></div></div>
   <div class="pathways-grid">
    <a class="pathway-card" href="/worksheets-by-grade/"><span class="pathway-number">01 / SUGGESTED GRADES</span><span class="pathway-icon" aria-hidden="true">G5</span><strong>Math by suggested grade</strong><span>Browse grade-level study paths and the Grade 5 standards sampler.</span><span class="pathway-arrow" aria-hidden="true">↗</span></a>
    <a class="pathway-card" href="/word-problems-worksheets/"><span class="pathway-number">02 / STORIES</span><span class="pathway-icon" aria-hidden="true">≡</span><strong>Original word problems</strong><span>Create contextual practice with matching answer and step PDFs.</span><span class="pathway-arrow" aria-hidden="true">↗</span></a>
    <a class="pathway-card" href="/algebra/"><span class="pathway-number">03 / ALGEBRA</span><span class="pathway-icon" aria-hidden="true">ƒ(x)</span><strong>Algebra pathways</strong><span>Equations, inequalities, functions and coordinate graphs.</span><span class="pathway-arrow" aria-hidden="true">↗</span></a>
    <a class="pathway-card" href="/geometry/"><span class="pathway-number">04 / GEOMETRY</span><span class="pathway-icon" aria-hidden="true">△</span><strong>Geometry pathways</strong><span>Angles, measurement, shapes and spatial reasoning.</span><span class="pathway-arrow" aria-hidden="true">↗</span></a>
   </div>
  </section>

  <section id="how-it-works" class="how-section" aria-labelledby="how-title">
   <div class="section-header"><div><span class="eyebrow">Simple by design</span><h2 id="how-title">From idea to printable practice.</h2><p>Everything you need for a useful worksheet, without a signup or extra software.</p></div></div>
   <div class="how-grid">
    <div class="how-card"><span class="how-number">01</span><h3>Pick a skill</h3><p>Choose an exact math topic and set the difficulty, question count and page size.</p></div>
    <div class="how-card"><span class="how-number">02</span><h3>Preview instantly</h3><p>See real generated questions, keep a reproducible seed and adjust before printing.</p></div>
    <div class="how-card"><span class="how-number">03</span><h3>Print with confidence</h3><p>Download separate student and matching answer PDFs. Worked steps appear where verified.</p></div>
   </div>
   <p class="how-note">Generated in your browser. No student login, hosted question database or paid generation service is required.</p>
  </section>
  <section id="choose-your-worksheet" class="topic-section" aria-labelledby="choose-worksheet-title" data-home-learning-guide>
   <div class="section-header"><div><span class="eyebrow">Quick reference for teachers and parents</span>
    <h2 id="choose-worksheet-title">Which printable math worksheet should I use?</h2>
    <p>Choose by the calculation or reasoning a student needs to practise, rather than by grade label alone. These links open real worksheet generators, not static keyword pages.</p>
   </div></div>
   <div class="geo-home-table-wrap"><table class="geo-home-table">
    <caption>Examples of matching a learning goal to a printable worksheet</caption>
    <thead><tr><th scope="col">Learning goal</th><th scope="col">Worksheet generator</th><th scope="col">What it checks</th></tr></thead>
    <tbody>
     <tr><th scope="row">Recall multiplication facts</th><td><a href="/multiplication-tables-worksheets/">Multiplication tables</a></td><td>Products and a separate completed 1–12 chart</td></tr>
     <tr><th scope="row">Show a division algorithm</th><td><a href="/long-division-worksheets/">Long division</a></td><td>Quotient steps, valid remainders, multiplication checks</td></tr>
     <tr><th scope="row">Add fractions with unlike denominators</th><td><a href="/adding-unlike-fractions-worksheets/">Fraction addition</a></td><td>Equivalent forms and common-denominator sums</td></tr>
     <tr><th scope="row">Measure a solid</th><td><a href="/volume-of-rectangular-prisms-worksheets/">Prism volume</a> or <a href="/surface-area-worksheets/">surface area</a></td><td>Cubic units for volume; square units for exposed faces</td></tr>
    </tbody>
   </table></div>
   <div class="geo-home-answers">
    <div><h3>Are printable answer keys included?</h3><p>Yes. Every core topic produces a separate matching answer-key PDF using the same question set and seed. Verified worked-step PDFs are offered only for supported topics.</p></div>
    <div><h3>Are the worksheets aligned to every grade standard?</h3><p>No. Grade navigation is suggested practice, not official curriculum certification. For an independent example of how skills are described, see the <a href="https://www.thecorestandards.org/Math/Content/6/G/" target="_blank" rel="noopener noreferrer">Common Core Grade 6 geometry standards</a>. Check your school's required scope and method before printing.</p></div>
   </div>
   <p class="geo-home-editorial">Worksheet descriptions and example mathematics are maintained by <a href="/about/">Math Worksheet Studio</a>; see our public <a href="https://github.com/garrison2025/Math_Works">repository and automated checking methods</a> or <a href="/contact/">report a correction</a>.</p>
  </section>
 </div>
<style>
.geo-home-table-wrap{width:100%;overflow-x:auto;border:1px solid #dce6ef;border-radius:14px;background:#fff}
.geo-home-table{border-collapse:collapse;width:100%;min-width:570px;font-size:.88rem;color:#40566e}
.geo-home-table caption{text-align:left;padding:12px 16px;font-size:.82rem;color:#52647d}
.geo-home-table th,.geo-home-table td{text-align:left;vertical-align:top;padding:13px 15px;border-top:1px solid #e2eaf2;line-height:1.55}
.geo-home-table thead th{background:#f4f9ff;color:#1b3753}
.geo-home-table tbody th{color:#253e56;font-weight:720;width:30%}
.geo-home-table a,.geo-home-answers a,.geo-home-editorial a{color:#1b64a5;text-decoration:underline;text-underline-offset:3px}
.geo-home-answers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:20px 0}
.geo-home-answers>div{padding:17px 19px;border-radius:13px;background:#f6faff;border:1px solid #e0e9f4}
.geo-home-answers h3{font-size:1rem;line-height:1.45;margin:0 0 9px}
.geo-home-answers p,.geo-home-editorial{font-size:.88rem;line-height:1.7;color:#40566e}
@media(max-width:700px){.geo-home-answers{grid-template-columns:1fr}.geo-home-table{font-size:.81rem}}
@media print{.geo-home-table-wrap{overflow:visible}.geo-home-table{min-width:0}}
</style>
</Layout>
