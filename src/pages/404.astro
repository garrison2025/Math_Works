---
import Layout from '../components/Layout.astro';
---
<Layout title="Page not found (404) | Math Worksheet Studio" description="That worksheet address is unavailable. Browse our active printable math worksheet generators instead." canonicalPath="/404/">
  <div class="container">
    <section class="hero hero-compact" aria-labelledby="missing-heading">
      <span class="eyebrow">404 · Page not found</span>
      <h1 id="missing-heading">This worksheet page isn't available.</h1>
      <p>The link may be incorrect, or the requested topic may not have a published generator. We don't show a different worksheet as if it were the one you requested.</p>
      <p><a class="btn btn-primary" href="/#topics">Browse available worksheets</a></p>
    </section>
    <section class="panel info-panel" aria-label="Other working worksheet topics">
      <h2>Try an active math practice generator</h2>
      <ul>
        <li><a href="/two-step-equations-worksheets/">Two-step equations</a></li>
        <li><a href="/adding-unlike-fractions-worksheets/">Adding unlike fractions</a></li>
        <li><a href="/scatter-plot-worksheets/">Scatter plots</a></li>
        <li><a href="/surface-area-worksheets/">Surface area</a></li>
      </ul>
    </section>
  </div>
</Layout>
