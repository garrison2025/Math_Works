---
import {makeWorksheet} from '../lib/math';
import {diagramSVG} from '../lib/diagram';
import {titleFor} from '../lib/site';
import {hasVerifiedSteps} from '../lib/capabilities';
import {topicOptionsFor} from '../lib/topic-options';
import {supportsExactNumber} from '../lib/answer-check';
import {fractionLayoutFor,fractionMarkup} from '../lib/fraction-layout';
const {slug}=Astro.props;
const worksheet=makeWorksheet(slug,20261104,8,'standard');
const hasSteps=hasVerifiedSteps(slug);
const specificOptions=topicOptionsFor(slug);
const hasDiagram=worksheet.problems.some(p=>Boolean(p.diagramSpec));
const canGradeSample=slug!=='decimal-place-value-worksheets'&&worksheet.problems.every(p=>supportsExactNumber(p.expectedAnswer));
---
<section class="workspace" data-workspace data-topic={slug} aria-label="Worksheet generator">
  <aside id="worksheet-settings" class="panel settings"><h2 class="panel-title">Customize worksheet</h2><p class="panel-sub">Your practice set is created right in this browser.</p>
    <div class="field"><label for="difficulty">Difficulty</label><select id="difficulty" data-field="difficulty"><option value="easy">Easy · smaller numbers</option><option value="standard" selected>Standard · balanced</option><option value="challenge">Challenge · larger numbers</option></select><p class="hint">Number ranges vary by topic. Answers stay exact.</p></div>
    {specificOptions.map(config=><div class="field"><label for={`topic-${config.key}`}>{config.label}</label><select id={`topic-${config.key}`} data-option={config.key}>{config.choices.map(c=><option value={c.value} selected={c.value===config.defaultValue}>{c.label}</option>)}</select><p class="hint">{config.hint}</p></div>)}
    <div class="field-row"><div class="field"><label for="quantity">Questions</label><select id="quantity" data-field="quantity"><option>4</option><option selected>8</option><option>12</option><option>16</option><option>20</option><option>30</option><option>40</option></select></div><div class="field"><label for="paper">Paper size</label><select id="paper" data-field="paper"><option value="Letter">US Letter</option><option value="A4">A4</option></select></div></div>
    <div class="field"><label for="writing-room">Practice PDF writing space</label><select id="writing-room" data-field="writing-room"><option value="standard" selected>Standard · compact practice</option><option value="extra">Extra room · more ruled lines</option></select><p class="hint">Adds 2 writing lines to text-only problems, or 1 below diagrams, on the <strong>questions PDF only</strong>. Existing protractor and long-division diagrams retain their calibrated/specialized workspace. Does not change questions, answers, or the on-screen preview.</p></div>
    <div class="field"><label for="seed">Worksheet seed <span style="color:#62738a;font-weight:500">reproducible</span></label><input id="seed" data-field="seed" type="number" min="0" max="4294967295" step="1" value="20261104" inputmode="numeric"/><p class="hint">Same topic, seed and settings produce the same questions.</p></div>
    <div class="actions"><button type="button" class="btn btn-primary" data-action="regenerate">↻ &nbsp; Generate new set</button><button type="button" class="btn btn-soft" data-action="worksheet">↓ &nbsp; Download worksheet PDF</button><div class="download-grid"><button type="button" class="btn" data-action="answers">Answer key PDF</button><button type="button" class="btn" data-action="steps" disabled={!hasSteps} title={hasSteps?"Verified step-by-step solution PDF":"Step-by-step PDF is not verified for this topic yet"}>Worked steps PDF</button></div>{slug==='printable-protractor'&&<button type="button" class="btn btn-secondary" data-action="protractor" title="One-page 180-degree protractor; check the 50 mm printed line">Download blank protractor PDF</button>}{slug==='multiplication-tables-worksheets'&&<div class="calibration-card" aria-label="Printable 1 to 12 multiplication grid"><strong>1–12 multiplication grid</strong><p class="hint">A full 12 × 12 fill-in chart (144 blank boxes). This is separate from the random fact-drill worksheet above; it does not change the seed, worksheet, or answer-key matching.</p><div class="download-grid"><button type="button" class="btn btn-secondary" data-action="multiplication-grid-blank">Blank 1–12 chart PDF</button><button type="button" class="btn" data-action="multiplication-grid-key">Completed chart answer PDF</button></div></div>}{(slug==='one-step-equations-worksheets'||slug==='two-step-equations-worksheets')&&<div class="calibration-card" data-r65-equation-pack aria-label="Decimal and fraction equation extensions">
<strong>Decimal and fraction equation practice</strong>
<p class="hint">Make a separate reproducible practice pack with exact decimal or simplified fraction answers. Student, answer-key and worked-step PDFs share the same seed, difficulty, question count, equation form, and paper settings above. These downloads do not replace the original integer generator or its live preview.</p>
<div class="field"><label for={`equation-kind-${slug}`}>Number type for extra practice</label><select id={`equation-kind-${slug}`} data-equation-kind><option value="decimal">Decimals · exact tenths / hundredths</option><option value="fraction">Fractions · exact simplified answers</option></select></div>
<div class="download-grid"><button type="button" class="btn btn-secondary" data-action="equation-pack-questions">Extra practice PDF</button><button type="button" class="btn" data-action="equation-pack-answers">Extra answer key PDF</button><button type="button" class="btn" data-action="equation-pack-steps">Extra worked steps PDF</button></div>
<p class="hint">The existing “Copy reproducible link” applies only to the original worksheet, not this separate extension. To recreate an extra pack, select the same number type and options with the same seed.</p>
</div>}{(slug==='number-line-worksheets'||slug==='fractions-worksheets')&&<div class="calibration-card" data-r66-fraction-number-line aria-label="Printable fraction number line practice">
<strong>Fractions on a number line</strong>
<p class="hint">Generate real fraction number-line diagrams with exact tick positions. Separate student and teacher PDFs; independent of your original number-line or fraction worksheet above.</p>
<div class="field"><label for="fraction-line-task">Fraction-line task</label><select id="fraction-line-task" data-fraction-line-task><option value="identify">Identify the fraction at a marked dot</option><option value="plot">Plot the given fraction on a blank line</option></select></div>
<div class="field"><label for="fraction-line-range">Number-line interval</label><select id="fraction-line-range" data-fraction-line-range><option value="zero-one">0–1 · proper fractions</option><option value="zero-two">0–2 · includes improper fractions</option></select></div>
<div class="download-grid"><button type="button" class="btn btn-secondary" data-action="fraction-line-questions">Fraction number-line student PDF</button><button type="button" class="btn" data-action="fraction-line-answers">Fraction number-line answer PDF</button></div>
<p class="hint">The same seed, difficulty, question count, task and interval reproduce the same sheet. Large question sets may include denominators up to 12. The original reproducible worksheet share link does not include these extra selectors.</p>
</div>}{slug==='division-worksheets'&&<div class="calibration-card" data-r67-decimal-division aria-label="Decimal division worksheets">
<strong>Decimal division practice with answers</strong>
<p class="hint">Generate a separate exact decimal division worksheet with decimal quotients. Choose whole-number or decimal divisors, select tenths or hundredths, and download matching student, answer and worked-step PDFs. The original integer division facts generator remains unchanged.</p>
<div class="field"><label for="decimal-divisor-kind">Divisor type</label><select id="decimal-divisor-kind" data-decimal-divisor><option value="mixed">Mix whole and decimal divisors</option><option value="whole">Whole-number divisors only</option><option value="decimal">Decimal divisors only</option></select></div>
<div class="field"><label for="decimal-quotient-precision">Quotient precision</label><select id="decimal-quotient-precision" data-decimal-precision><option value="mixed">Mix tenths and hundredths</option><option value="tenths">Tenths only</option><option value="hundredths">Hundredths only</option></select></div>
<div class="download-grid"><button type="button" class="btn btn-secondary" data-action="decimal-division-questions">Decimal student PDF</button><button type="button" class="btn" data-action="decimal-division-answers">Decimal answer key PDF</button><button type="button" class="btn" data-action="decimal-division-steps">Decimal worked steps PDF</button></div>
<p class="hint">Only terminating decimals with an exact noninteger quotient; no rounding, remainders, or repeating decimals. Same seed, difficulty, question count, divisor mode and precision reproduce the same pack. The original worksheet share link does not include these extra settings.</p>
</div>}{(slug==='addition-worksheets'||slug==='subtraction-worksheets'||slug==='mixed-addition-subtraction-worksheets')&&<div class="calibration-card" data-r68-decimal-add-sub aria-label="Aligned decimal addition and subtraction worksheet practice">
<strong>Decimal addition and subtraction — column worksheets</strong>
<p class="hint">Print decimal-point-aligned vertical problems using exact tenths and hundredths, with optional carrying or borrowing practice. The three PDF downloads use identical seed, quantity and settings; the original integer practice and its preview remain unchanged.</p>
<div class="field"><label for="decimal-add-sub-operation">Decimal operation</label><select id="decimal-add-sub-operation" data-decimal-add-sub-operation>
<option value="mixed" selected={slug!=='addition-worksheets'}>Mixed addition and subtraction</option>
<option value="addition" selected={slug==='addition-worksheets'}>Addition only</option>
<option value="subtraction">Subtraction only</option>
</select></div>
<div class="field"><label for="decimal-add-sub-places">Decimal places</label><select id="decimal-add-sub-places" data-decimal-add-sub-places>
<option value="mixed">Mix tenths and hundredths</option>
<option value="tenths">Tenths (one decimal place)</option>
<option value="hundredths">Hundredths (two decimal places)</option>
</select></div>
<div class="field"><label for="decimal-add-sub-regrouping">Carrying / borrowing</label><select id="decimal-add-sub-regrouping" data-decimal-add-sub-regrouping>
<option value="mixed">With and without regrouping</option>
<option value="yes">Require carrying or borrowing</option>
<option value="no">No carrying or borrowing</option>
</select></div>
<div class="download-grid"><button type="button" class="btn btn-secondary" data-action="decimal-add-sub-questions">Decimal student PDF</button><button type="button" class="btn" data-action="decimal-add-sub-answers">Decimal answer PDF</button><button type="button" class="btn" data-action="decimal-add-sub-steps">Decimal worked steps PDF</button></div>
<p class="hint">Students receive aligned column arithmetic with blank result lines; teachers receive matching exact keys and inverse-operation checks. Subtraction results are nonnegative. The original Copy reproducible link does not include these extra decimal settings.</p>
</div>}{slug==='fractions-worksheets'&&<div class="calibration-card" data-r69-conversion aria-label="Fractions and decimals conversion worksheets">
<strong>Convert fractions and decimals — printable practice</strong>
<p class="hint">Separate exact conversion practice, with genuinely reduced fractions and terminating decimals. Download matching student, answer and worked-step PDFs without changing your original fraction arithmetic sheet.</p>
<div class="field"><label for="fraction-decimal-direction">Conversion task</label><select id="fraction-decimal-direction" data-conversion-direction>
<option value="mixed">Both directions · mixed practice</option>
<option value="fraction-to-decimal">Fraction to decimal</option>
<option value="decimal-to-fraction">Decimal to simplest fraction</option>
</select></div>
<div class="field"><label for="fraction-decimal-precision">Decimal places</label><select id="fraction-decimal-precision" data-conversion-precision>
<option value="mixed">Mix tenths, hundredths, thousandths</option>
<option value="tenths">Tenths · one decimal place</option>
<option value="hundredths">Hundredths · two places</option>
<option value="thousandths">Thousandths · three places</option>
</select></div>
<div class="download-grid">
<button type="button" class="btn btn-secondary" data-action="conversion-questions">Conversion student PDF</button>
<button type="button" class="btn" data-action="conversion-answers">Conversion answer key PDF</button>
<button type="button" class="btn" data-action="conversion-steps">Conversion worked steps PDF</button>
</div>
<p class="hint">Fractions may be greater than one. All decimal results are exact, never rounded. Reuse the seed, question count, difficulty, conversion direction and decimal places to recreate the same pack. The original Copy reproducible link does not encode these additional settings.</p>
</div>}{(slug==='multiplication-worksheets'||slug==='division-worksheets')&&<div class="calibration-card" data-r71-multdiv-pack aria-label="Multiplication division fact-family and area-model printable practice">
<strong>Multiplication &amp; division skill packs</strong>
<p class="hint">Build a separate PDF with real mixed multiply/divide problems or all four related fact-family equations. Multiplication also supports a split rectangular area model with partial-product boxes. Your original v18 worksheet and its share link stay unchanged.</p>
<div class="field"><label for={`multdiv-mode-${slug}`}>Practice mode</label><select id={`multdiv-mode-${slug}`} data-multdiv-mode>
<option value="mixed-facts">Mixed multiplication and division facts</option>
<option value="fact-family">Four linked multiplication/division fact-family equations</option>
{slug==='multiplication-worksheets'&&<option value="area-model">Partitioned area model multiplication</option>}
</select></div>
{slug==='multiplication-worksheets'&&<div class="field"><label for="multdiv-factor-size">Area-model factor sizes</label><select id="multdiv-factor-size" data-multdiv-factors>
<option value="mixed">Mix 2-digit × 1-digit and 2-digit × 2-digit</option>
<option value="two-by-one">2-digit × 1-digit only</option>
<option value="two-by-two">2-digit × 2-digit only</option>
</select></div>}
<div class="download-grid">
<button class="btn btn-secondary" type="button" data-action="multdiv-questions">Extra student PDF</button>
<button class="btn" type="button" data-action="multdiv-answers">Extra answer key PDF</button>
<button class="btn" type="button" data-action="multdiv-steps">Extra worked steps PDF</button></div>
<p class="hint">Use the same seed, difficulty, number of problems, practice mode and paper size to reproduce identical student and teacher PDFs. In the area-model student file, partial-product cells are intentionally blank; the teacher PDF contains exact values.</p>
</div>}{slug==='fractions-worksheets'&&<div class="calibration-card" data-r72-fraction-strips aria-label="Print blank and labelled equal-width unit fraction strips">
<strong>Printable fraction strips — equal whole, exact parts</strong>
<p class="hint">Print real vector fraction strips that use the same 420 pt whole for every row, divided equally into halves, thirds, quarters and more. Choose blank strips for shading and cutting, or labelled teacher strips for reference.</p>
<div class="field"><label for="fraction-strip-set">Fraction strip denominators</label><select id="fraction-strip-set" data-fraction-strip-set>
<option value="extended">Extended: 1, 2, 3, 4, 5, 6, 8, 10 and 12</option>
<option value="basic">Basic: 1, 2, 3, 4, 6 and 8</option>
</select></div>
<div class="download-grid">
<button type="button" class="btn btn-secondary" data-action="fraction-strip-blank">Blank coloring strips PDF</button>
<button type="button" class="btn" data-action="fraction-strip-labeled">Labelled teacher strips PDF</button>
</div>
<p class="hint">Use the paper size above. This is a fixed printable chart rather than a randomized question set; changing the worksheet seed or question count does not change the strips. Print at Actual size (100%) for consistent physical lengths.</p>
</div>}{slug==='division-worksheets'&&<div class="calibration-card" data-r73-division-stories aria-label="Printable division word problems with interpreted remainders">
<strong>Division word problems — understand the remainder</strong>
<p class="hint">Real everyday stories: equal sharing, full groups with leftovers, extra vehicles needed, and finding what remains. The correct answer depends on what the question asks, not just the quotient. Separate printable student, teacher and worked-step PDFs.</p>
<div class="field"><label for="division-story-mode">Division story skill</label>
<select id="division-story-mode" data-division-story-mode>
<option value="mixed">Mix all four story types</option>
<option value="equal-sharing">Equal sharing, no remainder</option>
<option value="full-groups">Full groups and leftovers</option>
<option value="round-up">Round up to one more vehicle</option>
<option value="leftovers">Find the amount left over</option>
</select></div>
<div class="download-grid">
<button type="button" class="btn btn-secondary" data-action="division-story-questions">Division story student PDF</button>
<button type="button" class="btn" data-action="division-story-answers">Division story answer PDF</button>
<button type="button" class="btn" data-action="division-story-steps">Division story worked steps PDF</button>
</div>
<p class="hint">Includes 2- or 3-digit totals with one-digit divisors. Teacher keys state units and explain why a remainder means leftovers, a full-group limit or another vehicle. Seeds, difficulty, question count, Letter/A4 paper and writing room apply. The original division-facts worksheet and share link remain unchanged; no grade-level certification is claimed.</p>
</div>}{slug==='inequalities-worksheets'&&<div class="calibration-card" data-r74-inequalities aria-label="Translate sentences and graph compound inequalities">
<strong>Word-to-inequality and compound AND/OR practice</strong>
<p class="hint">Translate “at most,” “at least,” “less than” and “greater than” into correct inequalities. Practice both bounded intersections (AND) and separated solution rays (OR), with correctly open or filled endpoints.</p>
<div class="field"><label for="r74-inequality-mode">Extra inequality practice</label>
<select id="r74-inequality-mode" data-r74-inequality-mode>
<option value="mixed">Mixed translation, AND and OR</option>
<option value="translate">Translate English into algebra</option>
<option value="and">Compound inequalities — AND (intersection)</option>
<option value="or">Compound inequalities — OR (union)</option>
</select></div>
<div class="download-grid">
<button type="button" class="btn btn-secondary" data-action="r74-inequality-questions">Student practice PDF</button>
<button type="button" class="btn" data-action="r74-inequality-answers">Teacher answers PDF</button>
<button type="button" class="btn" data-action="r74-inequality-steps">Worked steps PDF</button>
</div>
<p class="hint">Example: “x is at least −2 and less than 5” means −2 ≤ x &lt; 5. The answer graph fills −2, leaves 5 open, and shades between. Choose the same seed, difficulty, count, mode and paper to reproduce the sheet. The original one/two-step worksheet remains separate.</p>
</div>}{slug==='area-worksheets'&&<div class="calibration-card" data-r74-circle-area aria-label="Exact circle and sector area practice">
<strong>Circle area and sector worksheets — exact answers in π</strong>
<p class="hint">Generate true radius/diameter circle-area questions, semicircles, quarter-circles and arbitrary minor sectors with a given central angle. Also find a positive radius from an exact area. Answers use reduced exact multiples of π, never an assumed rounded π value.</p>
<div class="field"><label for="r74-circle-mode">Circle area skill</label>
<select id="r74-circle-mode" data-r74-circle-mode>
<option value="mixed">Mixed circle and sector problems</option>
<option value="radius">Full circle — radius given</option>
<option value="diameter">Full circle — diameter given</option>
<option value="semicircle">Semicircle area (180°)</option>
<option value="quarter-circle">Quarter-circle area (90°)</option>
<option value="sector">Minor sector area (30°–180°)</option>
<option value="missing-radius">Find radius from exact area</option>
</select></div>
<div class="download-grid">
<button type="button" class="btn btn-secondary" data-action="r74-circle-questions">Circle student PDF</button>
<button type="button" class="btn" data-action="r74-circle-answers">Circle answer PDF</button>
<button type="button" class="btn" data-action="r74-circle-steps">Circle worked steps PDF</button>
</div>
<p class="hint">Example: a 90° sector with radius 6 cm has area 9π cm². PDF diagrams use true angular vectors; only the teacher file shows exact results. These optional packs do not change the original rectangle/square worksheet or its share link.</p>
</div>}<button type="button" class="btn btn-secondary" data-action="print">Open print-ready PDF</button><button type="button" class="btn" data-action="share">Copy reproducible link</button></div>
    <details class="calibration-card" data-print-calibration>
      <summary>Printer scale check <span class="calibration-mini">Recommended before classroom printing</span></summary>
      <p>Download a one-page calibration PDF using the paper size selected above. Print at <strong>Actual size / 100%</strong> with Fit/Shrink disabled. Use a physical ruler to measure both 100 mm reference bars.</p>
      <button type="button" class="btn btn-secondary" data-action="calibration">↓ Download printer calibration PDF</button>
      <div class="calibration-fields">
        <label for={`print-h-${slug}`}>Measured horizontal bar (mm)<input id={`print-h-${slug}`} data-calibration-axis="horizontal" type="number" min="1" max="200" step="0.1" inputmode="decimal" placeholder="100.0"/></label>
        <label for={`print-v-${slug}`}>Measured vertical bar (mm)<input id={`print-v-${slug}`} data-calibration-axis="vertical" type="number" min="1" max="200" step="0.1" inputmode="decimal" placeholder="100.0"/></label>
      </div>
      <button type="button" class="btn" data-action="check-calibration">Check entered measurements</button>
      <p class="calibration-result" data-calibration-result role="status" aria-live="polite">A reading within ±1 mm on both axes is a screening check only. Measurements stay in this browser. Physical printing is not automatically verified.</p>
    </details>
    <div class="status" aria-live="polite" role="status" data-status>8 questions ready · All generation happens on your device.</div><p class="controls-foot">Free to use · No account · No stored student data. The practice PDF and answer key use the same seed. Worked steps are provided for verified topics only.</p>
  </aside>
  <section class="panel preview-panel" aria-label="Live worksheet preview"><div class="preview-head"><div><strong>Live page preview</strong><a class="mobile-jump" href="#worksheet-settings">Customize &amp; download ↓</a><div><small data-summary>8 questions · Standard · US Letter</small></div></div><div class="preview-tools" role="group" aria-label="Preview mode"><button type="button" class="toggle" aria-pressed="true" data-mode="questions">Questions</button><button type="button" class="toggle" aria-pressed="false" data-mode="answers">Answers</button><button type="button" class="toggle" aria-pressed="false" data-mode="steps" disabled={!hasSteps} title={hasSteps?"Review worked steps":"Not yet verified for this topic"}>Steps</button><button type="button" class="toggle" data-action="practice" aria-pressed="false" hidden={!canGradeSample} title="Check numeric answers privately in this browser">Practice online</button></div></div>
  <div class="sheet-outer"><div id="worksheet-print" class="print-sheet" data-print-sheet><div class="sheet-top"><div><h2>{titleFor(slug)}</h2><p data-sheet-caption>Practice worksheet · Sheet ID {worksheet.seed}</p></div><span class="sheet-logo">MATH STUDIO</span></div><div class="sheet-name"><span>Name: _____________________</span><span>Date: ______________</span></div><div class:list={['problems-grid',{'with-diagrams':hasDiagram}]} data-problems>{worksheet.problems.map((p,i)=><div class="problem"><div class="no">{String(i+1).padStart(2,'0')}</div><div class="q">{p.payload.question}</div><Fragment set:html={fractionMarkup(fractionLayoutFor(slug,p.payload.question))}/>{p.diagramSpec&&<Fragment set:html={diagramSVG(p.diagramSpec)}/>}</div>)}</div><div class="sheet-footer"><span data-sheet-footer>Practice · Seed {worksheet.seed}</span><span data-page-footer>Generated locally • mathworksheetstudio</span></div></div></div>
  <div class="practice-actions" data-practice-actions hidden><p><strong>Quick answer check</strong> · Your answers stay in this browser. Type an integer, decimal or fraction, then check without revealing the answer key.</p><div class="practice-buttons"><button type="button" class="btn btn-primary" data-action="check-practice">Check my answers</button><button type="button" class="btn" data-action="clear-practice">Clear responses</button></div><p role="status" aria-live="polite" data-practice-summary>Enter your answers to begin.</p></div>
  </section>
</section>
<script>
 import {initWorkspaces} from '../client/workspace';
 initWorkspaces();
</script>
