---
import {makeWorksheet} from '../lib/math';
import {diagramSVG} from '../lib/diagram';
import {titleFor} from '../lib/site';
import {hasVerifiedSteps} from '../lib/capabilities';
import {topicOptionsFor} from '../lib/topic-options';
import {supportsExactNumber} from '../lib/answer-check';
import {fractionLayoutFor,fractionMarkup} from '../lib/fraction-layout';
const {slug}=Astro.props;
const worksheet=makeWorksheet(slug,20261104,8,'standard');
const hasSteps=hasVerifiedSteps(slug);
const specificOptions=topicOptionsFor(slug);
const hasDiagram=worksheet.problems.some(p=>Boolean(p.diagramSpec));
const canGradeSample=slug!=='decimal-place-value-worksheets'&&worksheet.problems.every(p=>supportsExactNumber(p.expectedAnswer));
---
<section class="workspace" data-workspace data-topic={slug} aria-label="Worksheet generator">
  <aside id="worksheet-settings" class="panel settings"><h2 class="panel-title">Customize worksheet</h2><p class="panel-sub">Your practice set is created right in this browser.</p>
    <div class="field"><label for="difficulty">Difficulty</label><select id="difficulty" data-field="difficulty"><option value="easy">Easy · smaller numbers</option><option value="standard" selected>Standard · balanced</option><option value="challenge">Challenge · larger numbers</option></select><p class="hint">Number ranges vary by topic. Answers stay exact.</p></div>
    {specificOptions.map(config=><div class="field"><label for={`topic-${config.key}`}>{config.label}</label><select id={`topic-${config.key}`} data-option={config.key}>{config.choices.map(c=><option value={c.value} selected={c.value===config.defaultValue}>{c.label}</option>)}</select><p class="hint">{config.hint}</p></div>)}
    <div class="field-row"><div class="field"><label for="quantity">Questions</label><select id="quantity" data-field="quantity"><option>4</option><option selected>8</option><option>12</option><option>16</option><option>20</option><option>30</option><option>40</option></select></div><div class="field"><label for="paper">Paper size</label><select id="paper" data-field="paper"><option value="Letter">US Letter</option><option value="A4">A4</option></select></div></div>
    <div class="field"><label for="seed">Worksheet seed <span style="color:#62738a;font-weight:500">reproducible</span></label><input id="seed" data-field="seed" type="number" min="0" max="4294967295" step="1" value="20261104" inputmode="numeric"/><p class="hint">Same topic, seed and settings produce the same questions.</p></div>
    <div class="actions"><button type="button" class="btn btn-primary" data-action="regenerate">↻ &nbsp; Generate new set</button><button type="button" class="btn btn-soft" data-action="worksheet">↓ &nbsp; Download worksheet PDF</button><div class="download-grid"><button type="button" class="btn" data-action="answers">Answer key PDF</button><button type="button" class="btn" data-action="steps" disabled={!hasSteps} title={hasSteps?"Verified step-by-step solution PDF":"Step-by-step PDF is not verified for this topic yet"}>Worked steps PDF</button></div>{slug==='printable-protractor'&&<button type="button" class="btn btn-secondary" data-action="protractor" title="One-page 180-degree protractor; check the 50 mm printed line">Download blank protractor PDF</button>}<button type="button" class="btn btn-secondary" data-action="print">Open print-ready PDF</button><button type="button" class="btn" data-action="share">Copy reproducible link</button></div>
    <details class="calibration-card" data-print-calibration>
      <summary>Printer scale check <span class="calibration-mini">Recommended before classroom printing</span></summary>
      <p>Download a one-page calibration PDF using the paper size selected above. Print at <strong>Actual size / 100%</strong> with Fit/Shrink disabled. Use a physical ruler to measure both 100 mm reference bars.</p>
      <button type="button" class="btn btn-secondary" data-action="calibration">↓ Download printer calibration PDF</button>
      <div class="calibration-fields">
        <label for={`print-h-${slug}`}>Measured horizontal bar (mm)<input id={`print-h-${slug}`} data-calibration-axis="horizontal" type="number" min="1" max="200" step="0.1" inputmode="decimal" placeholder="100.0"/></label>
        <label for={`print-v-${slug}`}>Measured vertical bar (mm)<input id={`print-v-${slug}`} data-calibration-axis="vertical" type="number" min="1" max="200" step="0.1" inputmode="decimal" placeholder="100.0"/></label>
      </div>
      <button type="button" class="btn" data-action="check-calibration">Check entered measurements</button>
      <p class="calibration-result" data-calibration-result role="status" aria-live="polite">A reading within ±1 mm on both axes is a screening check only. Measurements stay in this browser. Physical printing is not automatically verified.</p>
    </details>
    <div class="status" aria-live="polite" role="status" data-status>8 questions ready · All generation happens on your device.</div><p class="controls-foot">Free to use · No account · No stored student data. The practice PDF and answer key use the same seed. Worked steps are provided for verified topics only.</p>
  </aside>
  <section class="panel preview-panel" aria-label="Live worksheet preview"><div class="preview-head"><div><strong>Live page preview</strong><a class="mobile-jump" href="#worksheet-settings">Customize &amp; download ↓</a><div><small data-summary>8 questions · Standard · US Letter</small></div></div><div class="preview-tools" role="group" aria-label="Preview mode"><button type="button" class="toggle" aria-pressed="true" data-mode="questions">Questions</button><button type="button" class="toggle" aria-pressed="false" data-mode="answers">Answers</button><button type="button" class="toggle" aria-pressed="false" data-mode="steps" disabled={!hasSteps} title={hasSteps?"Review worked steps":"Not yet verified for this topic"}>Steps</button><button type="button" class="toggle" data-action="practice" aria-pressed="false" hidden={!canGradeSample} title="Check numeric answers privately in this browser">Practice online</button></div></div>
  <div class="sheet-outer"><div id="worksheet-print" class="print-sheet" data-print-sheet><div class="sheet-top"><div><h2>{titleFor(slug)}</h2><p data-sheet-caption>Practice worksheet · Sheet ID {worksheet.seed}</p></div><span class="sheet-logo">MATH STUDIO</span></div><div class="sheet-name"><span>Name: _____________________</span><span>Date: ______________</span></div><div class:list={['problems-grid',{'with-diagrams':hasDiagram}]} data-problems>{worksheet.problems.map((p,i)=><div class="problem"><div class="no">{String(i+1).padStart(2,'0')}</div><div class="q">{p.payload.question}</div><Fragment set:html={fractionMarkup(fractionLayoutFor(slug,p.payload.question))}/>{p.diagramSpec&&<Fragment set:html={diagramSVG(p.diagramSpec)}/>}</div>)}</div><div class="sheet-footer"><span data-sheet-footer>Practice · Seed {worksheet.seed}</span><span data-page-footer>Generated locally • mathworksheetstudio</span></div></div></div>
  <div class="practice-actions" data-practice-actions hidden><p><strong>Quick answer check</strong> · Your answers stay in this browser. Type an integer, decimal or fraction, then check without revealing the answer key.</p><div class="practice-buttons"><button type="button" class="btn btn-primary" data-action="check-practice">Check my answers</button><button type="button" class="btn" data-action="clear-practice">Clear responses</button></div><p role="status" aria-live="polite" data-practice-summary>Enter your answers to begin.</p></div>
  </section>
</section>
<script>
 import {initWorkspaces} from '../client/workspace';
 initWorkspaces();
</script>
