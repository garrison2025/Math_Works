---
import routes from '../data/routes.json';
import targets from '../data/seo-targets.json';
import {titleFor,topicIntro} from '../lib/site';
import {WORKSHEET_SECTIONS,sectionData,worksheetSectionFor,type WorksheetSection} from '../lib/worksheet-directory';
interface Props {section?:WorksheetSection}
const {section}=Astro.props;
const sections=section?[sectionData(section)]:WORKSHEET_SECTIONS;
const available=routes.filter(route=>route.type!=='HOLD');
const getRoutes=(slug:WorksheetSection)=>available.filter(route=>worksheetSectionFor(route.slug)===slug)
 .sort((a,b)=>Number(a.type==='CONDITIONAL_HUB')-Number(b.type==='CONDITIONAL_HUB')||
  ['SEO-A','SEO-B','SEO-C'].indexOf(a.tier)-['SEO-A','SEO-B','SEO-C'].indexOf(b.tier)||
  a.slug.localeCompare(b.slug));
const primaries=new Map(targets.map(t=>[t.slug,t.primary]));
---
<div class="container">
 <nav class="directory-nav" aria-label="Math worksheet subject directories">
  <a href="/worksheets/" aria-current={!section?'page':undefined}>All worksheets</a>
  {WORKSHEET_SECTIONS.map(group=><a href={`/${group.slug}/`} aria-current={section===group.slug?'page':undefined}>{group.slug==='data-statistics'?'Data & statistics':group.slug.charAt(0).toUpperCase()+group.slug.slice(1)}</a>)}
 </nav>
 {sections.map(group=><section class="directory-group" id={group.slug} aria-labelledby={`heading-${group.slug}`}>
  <div class="directory-heading">
   <div>
    <p class="directory-eyebrow">{getRoutes(group.slug).length} working worksheet topics</p>
    <h2 id={`heading-${group.slug}`}>{group.title}</h2>
    <p>{group.description}</p>
   </div>
   {!section&&<a class="directory-more" href={`/${group.slug}/`}>View subject directory →</a>}
  </div>
  <div class="directory-grid">
   {getRoutes(group.slug).map(route=><a class="directory-card" href={`/${route.slug}/`}>
    <span class="directory-card-type">{route.type==='CONDITIONAL_HUB'?'General practice':'Focused practice'}</span>
    <strong>{titleFor(route.slug)}</strong>
    <span class="directory-card-keyword">{primaries.get(route.slug)}</span>
    <span class="directory-card-description">{topicIntro(route.slug)}</span>
    <span class="directory-card-action">Open generator →</span>
   </a>)}
  </div>
 </section>)}
 <p class="directory-note">These are browser-based tools with reproducible practice sets and matching answer PDFs. Topic pages are not grade-level certifications. Broad or unbuilt concepts from the original planning sheet are deliberately not presented as working tools.</p>
</div>
<style>
 .directory-nav{display:flex;gap:9px;overflow-x:auto;padding:12px 0 24px;scrollbar-width:thin}
 .directory-nav a{white-space:nowrap;flex:none;text-decoration:none;padding:10px 14px;border-radius:999px;border:1px solid #d7e0e9;color:#34485d;background:#fff;font-weight:650;font-size:.88rem}
 .directory-nav a[aria-current="page"]{background:#1b64a5;color:#fff;border-color:#1b64a5}
 .directory-nav a:focus-visible,.directory-card:focus-visible,.directory-more:focus-visible{outline:3px solid #187b68;outline-offset:3px}
 .directory-group{padding:22px 0 37px;border-bottom:1px solid #d7e0e9}
 .directory-heading{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:19px}
 .directory-heading h2{font-size:clamp(1.45rem,2.6vw,2rem);margin:5px 0 8px;color:#172337}
 .directory-heading p{margin:0;color:#53647a;max-width:66ch;line-height:1.55}
 .directory-eyebrow{text-transform:uppercase;letter-spacing:.08em;font-size:.72rem;font-weight:800;color:#187b68!important}
 .directory-more{flex:none;font-weight:700;text-decoration:none;color:#1b64a5;padding-bottom:4px}
 .directory-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,252px),1fr));gap:14px}
 .directory-card{display:flex;flex-direction:column;gap:7px;min-height:190px;background:#fff;border:1px solid #d7e0e9;border-radius:16px;padding:20px;text-decoration:none;color:#172337;box-shadow:0 2px 4px #17233706;transition:border-color .15s,transform .15s,box-shadow .15s}
 .directory-card:hover{border-color:#1b64a5;transform:translateY(-2px);box-shadow:0 10px 24px #17233712}
 .directory-card-type{font-size:.7rem;letter-spacing:.065em;text-transform:uppercase;color:#187b68;font-weight:800}
 .directory-card strong{font-size:1.04rem;line-height:1.35}
 .directory-card-keyword{font-size:.79rem;color:#53647a;font-weight:600}
 .directory-card-description{color:#53647a;font-size:.84rem;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
 .directory-card-action{font-size:.86rem;font-weight:750;color:#1b64a5;margin-top:auto;padding-top:9px}
 .directory-note{color:#56667b;font-size:.87rem;line-height:1.65;margin:24px 0 40px}
 @media(max-width:680px){.directory-heading{align-items:start;flex-direction:column;gap:10px}.directory-grid{grid-template-columns:1fr}.directory-card{min-height:0}.directory-more{padding:3px 0}}
 @media(prefers-reduced-motion:reduce){.directory-card{transition:none}.directory-card:hover{transform:none}}
</style>
