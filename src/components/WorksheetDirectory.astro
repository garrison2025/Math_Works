---
import routes from '../data/routes.json';
import targets from '../data/seo-targets.json';
import {titleFor,topicIntro} from '../lib/site';
import {WORKSHEET_SECTIONS,sectionData,worksheetSectionFor,type WorksheetSection} from '../lib/worksheet-directory';
interface Props {section?:WorksheetSection}
const {section}=Astro.props;
const sections=section?[sectionData(section)]:WORKSHEET_SECTIONS;
const available=routes.filter(route=>route.type!=='HOLD');
const getRoutes=(slug:WorksheetSection)=>available.filter(route=>worksheetSectionFor(route.slug)===slug)
 .sort((a,b)=>Number(a.type==='CONDITIONAL_HUB')-Number(b.type==='CONDITIONAL_HUB')||
  ['SEO-A','SEO-B','SEO-C'].indexOf(a.tier)-['SEO-A','SEO-B','SEO-C'].indexOf(b.tier)||
  a.slug.localeCompare(b.slug));
const primaries=new Map(targets.map(t=>[t.slug,t.primary]));
---
<div class="container" data-worksheet-directory>
 <div class="directory-search" data-directory-search hidden>
  <form role="search" aria-label="Search the worksheet library">
   <label for="directory-query">Find a math worksheet</label>
   <p id="directory-search-hint">Search by a math skill or exact worksheet phrase. Results lead only to working generators.</p>
   <div class="directory-search-row">
    <input id="directory-query" data-directory-query type="search" autocomplete="off" spellcheck="false" placeholder="e.g. rectangular prism surface area" aria-describedby="directory-search-hint directory-search-status" aria-controls="directory-matches"/>
    <button type="submit" data-directory-submit>Search</button>
    <button type="button" data-directory-clear hidden aria-label="Clear worksheet search">Clear</button>
   </div>
  </form>
  <div class="directory-quick-filters" role="group" aria-label="Try a quick worksheet search">
   <span>Try a skill</span>
   <button type="button" data-directory-suggestion="fractions">Fractions</button>
   <button type="button" data-directory-suggestion="multiplication">Multiplication</button>
   <button type="button" data-directory-suggestion="equations">Equations</button>
   <button type="button" data-directory-suggestion="geometry">Geometry</button>
   <button type="button" data-directory-suggestion="word problems">Word problems</button>
  </div>
  <p id="directory-search-status" data-directory-status role="status" aria-live="polite"></p>
  <ul id="directory-matches" class="directory-matches" data-directory-matches hidden aria-label="Specific matched worksheet tasks"></ul>
 </div>
 <section class="directory-extras" aria-label="Guided worksheet collections">
  <h2>Find practice by need</h2>
  <p>Choose a suggested grade, a subject pathway, or fresh original word problems. These pages link to actual working tools, rather than presenting an unsupported all-in-one worksheet.</p>
  <div class="directory-grid">
   <a class="directory-card" href="/word-problems-worksheets/"><span class="directory-card-type">Live story generator</span><strong>Word Problems Worksheets</strong><span class="directory-card-description">Unit rates, area, multiplication and equal sharing; student, answer and step PDFs.</span><span class="directory-card-action">Create word problems →</span></a>
   <a class="directory-card" href="/worksheets-by-grade/"><span class="directory-card-type">Suggested skill navigation</span><strong>Math Worksheets by Grade</strong><span class="directory-card-description">Grade 5, 6, 7 and 8 suggested study paths linked to working math generators.</span><span class="directory-card-action">Browse by grade →</span></a>
   <a class="directory-card" href="/algebra-general-worksheets/"><span class="directory-card-type">Subject pathway</span><strong>Algebra Worksheets</strong><span class="directory-card-description">Equations, functions, inequalities and slope; choose the specific algebra task.</span><span class="directory-card-action">Browse algebra →</span></a>
   <a class="directory-card" href="/geometry-general-worksheets/"><span class="directory-card-type">Subject pathway</span><strong>Geometry Worksheets</strong><span class="directory-card-description">Geometric area, volume, angles, lines, triangles and graphs.</span><span class="directory-card-action">Browse geometry →</span></a>
  </div>
 </section>
 <nav class="directory-nav" aria-label="Math worksheet subject directories">
  <a href="/worksheets/" aria-current={!section?'page':undefined}>All worksheets</a>
  {WORKSHEET_SECTIONS.map(group=><a href={`/${group.slug}/`} aria-current={section===group.slug?'page':undefined}>{group.slug==='data-statistics'?'Data & statistics':group.slug.charAt(0).toUpperCase()+group.slug.slice(1)}</a>)}
 </nav>
 {sections.map(group=><section class="directory-group" id={group.slug} aria-labelledby={`heading-${group.slug}`}>
  <div class="directory-heading">
   <div>
    <p class="directory-eyebrow">{getRoutes(group.slug).length} working worksheet topics</p>
    <h2 id={`heading-${group.slug}`}>{group.title}</h2>
    <p>{group.description}</p>
   </div>
   {!section&&<a class="directory-more" href={`/${group.slug}/`}>View subject directory →</a>}
  </div>
  <div class="directory-grid">
   {getRoutes(group.slug).map(route=><a class="directory-card" data-slug={route.slug} href={`/${route.slug}/`}>
    <span class="directory-card-type">{route.type==='CONDITIONAL_HUB'?'General practice':'Focused practice'}</span>
    <strong>{titleFor(route.slug)}</strong>
    <span class="directory-card-keyword">{primaries.get(route.slug)}</span>
    <span class="directory-card-description">{topicIntro(route.slug)}</span>
    <span class="directory-card-action">Open generator →</span>
   </a>)}
  </div>
 </section>)}
 <p class="directory-note">The 51 original v18 worksheet generators and the independent word-story tool work in your browser, with matching printable PDF answers. Grade and subject guides link to implemented topics; they do not claim official grade certification or unsupported search phrases.</p>
</div>
<style>
 .directory-extras{padding:15px 0 24px}.directory-extras h2{font-size:1.3rem;margin:0 0 7px;color:#172337}.directory-extras>p{font-size:.88rem;color:#53647a;line-height:1.55;margin:0 0 16px;max-width:70ch}
 .directory-search{padding:23px;margin:18px 0 12px;background:linear-gradient(135deg,#f3f8fc 0%,#f1f9f6 100%);border:1px solid #d7e0e9;border-radius:18px}
 .directory-search label{display:block;color:#172337;font-size:1.12rem;font-weight:800}
 .directory-search form>p{color:#53647a;margin:7px 0 14px;font-size:.87rem;line-height:1.5}
 .directory-search-row{display:flex;gap:10px;max-width:730px}
 .directory-search input{min-width:0;flex:1;height:48px;padding:0 14px;border:1.5px solid #9aabba;border-radius:10px;background:#fff;color:#172337;font:inherit;font-size:1rem}
 .directory-search button{border:1px solid #9aabba;border-radius:10px;background:#fff;color:#172337;font-weight:750;padding:0 18px;min-height:44px;cursor:pointer}
 .directory-search button[data-directory-submit]{background:#1b64a5;color:#fff;border-color:#1b64a5}
 .directory-search input:focus-visible,.directory-search button:focus-visible,.directory-matches a:focus-visible{outline:3px solid #187b68;outline-offset:3px}
 .directory-search [data-directory-status]{color:#53647a;font-size:.84rem;line-height:1.5;margin:12px 0 0}
 .directory-matches{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,285px),1fr));gap:8px;padding:0;margin:15px 0 0}
 .directory-matches a{border:1px solid #d7e0e9;background:white;border-radius:10px;padding:13px 15px;display:flex;gap:6px;flex-direction:column;text-decoration:none;color:#172337}
 .directory-matches a:hover{border-color:#1b64a5}
 .directory-matches strong{line-height:1.35;font-size:.92rem}
 .directory-matches span{color:#53647a;font-size:.77rem;line-height:1.45}
 .directory-search[hidden],.directory-card[hidden],.directory-group[hidden],.directory-matches[hidden],.directory-search button[hidden]{display:none!important}
 .directory-nav{display:flex;gap:9px;overflow-x:auto;padding:12px 0 24px;scrollbar-width:thin}
 .directory-nav a{white-space:nowrap;flex:none;text-decoration:none;padding:10px 14px;border-radius:999px;border:1px solid #d7e0e9;color:#34485d;background:#fff;font-weight:650;font-size:.88rem}
 .directory-nav a[aria-current="page"]{background:#1b64a5;color:#fff;border-color:#1b64a5}
 .directory-nav a:focus-visible,.directory-card:focus-visible,.directory-more:focus-visible{outline:3px solid #187b68;outline-offset:3px}
 .directory-group{padding:22px 0 37px;border-bottom:1px solid #d7e0e9}
 .directory-heading{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:19px}
 .directory-heading h2{font-size:clamp(1.45rem,2.6vw,2rem);margin:5px 0 8px;color:#172337}
 .directory-heading p{margin:0;color:#53647a;max-width:66ch;line-height:1.55}
 .directory-eyebrow{text-transform:uppercase;letter-spacing:.08em;font-size:.72rem;font-weight:800;color:#187b68!important}
 .directory-more{flex:none;font-weight:700;text-decoration:none;color:#1b64a5;padding-bottom:4px}
 .directory-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,252px),1fr));gap:14px}
 .directory-card{display:flex;flex-direction:column;gap:7px;min-height:190px;background:#fff;border:1px solid #d7e0e9;border-radius:16px;padding:20px;text-decoration:none;color:#172337;box-shadow:0 2px 4px #17233706;transition:border-color .15s,transform .15s,box-shadow .15s}
 .directory-card:hover{border-color:#1b64a5;transform:translateY(-2px);box-shadow:0 10px 24px #17233712}
 .directory-card-type{font-size:.7rem;letter-spacing:.065em;text-transform:uppercase;color:#187b68;font-weight:800}
 .directory-card strong{font-size:1.04rem;line-height:1.35}
 .directory-card-keyword{font-size:.79rem;color:#53647a;font-weight:600}
 .directory-card-description{color:#53647a;font-size:.84rem;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
 .directory-card-action{font-size:.86rem;font-weight:750;color:#1b64a5;margin-top:auto;padding-top:9px}
 .directory-note{color:#56667b;font-size:.87rem;line-height:1.65;margin:24px 0 40px}
 @media(max-width:680px){.directory-search-row{flex-wrap:wrap}.directory-search input{flex-basis:100%}.directory-heading{align-items:start;flex-direction:column;gap:10px}.directory-grid{grid-template-columns:1fr}.directory-card{min-height:0}.directory-more{padding:3px 0}}
 @media(prefers-reduced-motion:reduce){.directory-card{transition:none}.directory-card:hover{transform:none}}

 /* R105 direct-touch skill shortcuts; the same existing search index handles results. */
 .directory-quick-filters{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-top:13px}
 .directory-quick-filters>span{font-size:.74rem;color:#61748b;font-weight:730;margin-right:4px}
 .directory-search .directory-quick-filters button{min-height:32px;border-radius:999px;border:1px solid #c8d9eb;padding:6px 11px;background:#fff;color:#315278;font-size:.73rem;font-weight:690;transition:background-color .17s,border-color .17s,transform .17s}
 .directory-search .directory-quick-filters button:hover{background:#e6f0ff;border-color:#91b5e7;transform:translateY(-1px)}
 .directory-search .directory-quick-filters button[aria-pressed="true"]{background:#214fb8;border-color:#214fb8;color:white}
 .directory-matches:not([hidden])>li{animation:r105-suggest .21s cubic-bezier(.2,.75,.2,1) both}
 .directory-matches:not([hidden])>li:nth-child(2n){animation-delay:35ms}
 @keyframes r105-suggest{from{opacity:.5;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
 @media(prefers-reduced-motion:reduce){.directory-search .directory-quick-filters button{transition:none}.directory-search .directory-quick-filters button:hover{transform:none}.directory-matches:not([hidden])>li{animation:none}}
</style>

<script>import '../client/worksheet-directory-search.ts';</script>
