---
import '../styles/global.css';
import topics from '../data/routes.json';
import seoTargets from '../data/seo-targets.json';
import {isIndexablePath,absoluteSite} from '../lib/indexation';
const {title,description,canonicalPath='/'}=Astro.props;
const release={site:import.meta.env.PUBLIC_SITE_URL||'', enabled:import.meta.env.PUBLIC_INDEXABLE||'', routes:import.meta.env.PUBLIC_INDEXABLE_ROUTES||'', hubs:import.meta.env.PUBLIC_INDEXABLE_HUB_ROUTES||'', branch:process.env.CF_PAGES_BRANCH||''};
const base=absoluteSite(release);
const indexed=isIndexablePath(canonicalPath,release,topics);
const canonical=indexed?`${base}${canonicalPath}`:undefined;
// Cloudflare Pages exposes the exact deployed Git commit at build time.
const sourceRevision=process.env.CF_PAGES_COMMIT_SHA||process.env.GITHUB_SHA||'';
const buildRevision=/^[a-f0-9]{40}$/i.test(sourceRevision)?sourceRevision.toLowerCase():undefined;
// R62: structured data describes actual worksheet generators. Emit NONE on
// the unapproved noindex/pages.dev preview; no false grade or review ratings.
const focus=seoTargets.find(t=>canonicalPath===`/${t.slug}/`);
const webApplication={
 "@type":"WebApplication",name:"Printable Math Worksheet Studio",url:canonical,
 applicationCategory:"EducationalApplication",operatingSystem:"Web browser",
 offers:{"@type":"Offer",price:"0",priceCurrency:"USD"},description
};
const resource=focus?{
 "@type":"LearningResource",name:title,url:canonical,inLanguage:"en-US",
 isAccessibleForFree:true,learningResourceType:"Worksheet",
 educationalUse:"practice",about:focus.primary,description
}:undefined;
const crumbs=focus?{
 "@type":"BreadcrumbList",itemListElement:[
  {"@type":"ListItem",position:1,name:"All math worksheets",item:`${base}/`},
  {"@type":"ListItem",position:2,name:title,item:canonical}
 ]
}:undefined;
const structured=indexed?{
 "@context":"https://schema.org",
 "@graph":[webApplication,...(resource?[resource]:[]),...(crumbs?[crumbs]:[])]
}:undefined;
---
<!DOCTYPE html>
<html lang="en-US"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="color-scheme" content="light"/><title>{title}</title><meta name="description" content={description}/>{buildRevision&&<meta name="math-works-build-sha" content={buildRevision}/>}<meta name="robots" content={indexed?'index,follow,max-image-preview:large':'noindex,nofollow'}/>{canonical&&<link rel="canonical" href={canonical}/>}
<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/>{canonical&&<meta property="og:url" content={canonical}/>}<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>{structured&&<script type="application/ld+json" set:html={JSON.stringify(structured)} />}</head>
<body><a class="skip-link" href="#main-content">Skip to main content</a><header class="site-header"><div class="container header-inner"><a class="brand" href="/" aria-label="Math Worksheet Studio home"><span class="brand-mark">∑</span><span>Math Worksheet <span style="color:#1b64a5">Studio</span></span></a><nav class="header-nav" aria-label="Main navigation"><a href="/#how-it-works">How it works</a><a class="nav-pill" href="/worksheets/">Find a worksheet</a></nav></div></header><main id="main-content" tabindex="-1"><slot /></main><footer class="site-footer"><div class="container footer-inner"><span>© {new Date().getFullYear()} Math Worksheet Studio · Free, locally generated practice sheets.</span><div class="footer-links"><a href="/worksheets/">Worksheets</a><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/contact/">Contact</a></div></div></footer></body></html>
